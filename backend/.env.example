# App
# В production задайте APP_ENV=production и случайные секреты от 32 символов:
# с примерными значениями приложение не запустится. Значение по умолчанию — production.
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-minimum-32-characters-long

# Database
DATABASE_URL=postgresql+asyncpg://nexora:nexora@localhost:5432/nexora

# Redis (в docker-compose Redis защищён паролем: redis://:ПАРОЛЬ@localhost:6379/0)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-another-secret-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram
TELEGRAM_WEBHOOK_SECRET=random-secret

# Сколько прокси перед приложением дописывают адрес в X-Forwarded-For (включая nginx).
# Иначе лимиты запросов и журнал аудита видят подделанный IP.
# За цепочкой Cloudflare → Traefik → nginx значение 3.
TRUSTED_PROXY_COUNT=1

# Сколько дней хранить IP и User-Agent в журналах (ФЗ-152)
AUDIT_RETENTION_DAYS=365

# CORS (JSON array or comma-separated)
CORS_ORIGINS=http://localhost:4200,http://localhost:5558,https://nexora.prdxso.dev,https://nexora.prdx.so

# Logging
LOG_LEVEL=INFO
